# ---------------------------------------------------------------------------
# Bu dosyayı .env.local olarak kopyala ve doldur. .env.local gitignore'dadır.
# Hiçbiri ücretli servis değildir: Supabase Free + Discord Developer (ücretsiz).
# ---------------------------------------------------------------------------

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Sitenin genel adresi (OG görselleri, sitemap, canonical için)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Sadece sunucu tarafı / collector. Tarayıcıya ASLA sızdırma. ---
# GitHub Actions'ta repository secrets olarak tanımlanır.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Discord (Faz 5) ---
DISCORD_APP_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
DISCORD_ANNOUNCE_WEBHOOK_URL=

# --- Yönetim ---
# Virgülle ayrılmış izinli yönetici e-postaları
ADMIN_EMAILS=seninmailin@example.com

# clicks.ip_hash için günlük tuz. Rastgele uzun bir dize üret.
CLICK_HASH_SALT=degistir-bunu
